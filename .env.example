# Environment Configuration for WAN 2.2 Video Generation Service
# Copy this file to .env and fill in your values

# Lambda Labs API Key (for programmatic instance management)
LAMBDA_API_KEY=secret_sora2_YOUR_KEY_HERE

# GPU Service Configuration
GPU_SERVICE_URL=http://your-lambda-instance-ip:8001
GPU_API_KEY=your-secret-key-123

# Local Backend Configuration
USE_REMOTE_GPU=true
HOST=127.0.0.1
PORT=8000

# ============================================================================
# WAN 2.2 Model Configuration
# ============================================================================

# Model ID - Choose based on your GPU VRAM:
# - "Wan-AI/Wan2.2-I2V-A14B-Diffusers" (14B params, requires 80GB VRAM, best quality)
# - "Wan-AI/Wan2.2-TI2V-5B-Diffusers" (5B params, requires 24GB VRAM, RTX 4090 compatible)
WAN_MODEL_ID=Wan-AI/Wan2.2-I2V-A14B-Diffusers

# Model Variant (for I2V-A14B only): "480P" or "720P"
WAN_MODEL_VARIANT=720P

# Resolution (defaults based on model and aspect ratio)
# I2V-A14B 720P: 1280x720 or 720x1280
# I2V-A14B 480P: 832x480 or 480x832
# TI2V-5B: 1280x704 or 704x1280
WAN_WIDTH=1280
WAN_HEIGHT=720

# ============================================================================
# Generation Quality Settings
# ============================================================================

# Diffusion steps (default: 40, range: 20-100)
# Higher = better quality but slower
DEFAULT_NUM_STEPS=40

# Text guidance strength (default: 5.0, range: 1.0-15.0)
# Higher = stronger adherence to prompt
DEFAULT_GUIDANCE=5.0

# Image guidance for I2V (default: 3.5, range: 0.5-10.0)
# Higher = stronger preservation of input image
DEFAULT_GUIDANCE_IMG=3.5

# ============================================================================
# Memory Optimization
# ============================================================================

# Enable model CPU offload (for low VRAM GPUs)
# Set to "true" if you have less than required VRAM
WAN_ENABLE_MODEL_CPU_OFFLOAD=false

# Enable VAE slicing (reduces VRAM usage, recommended)
WAN_ENABLE_VAE_SLICING=true

# Enable VAE tiling (reduces VRAM usage, may affect quality)
WAN_ENABLE_VAE_TILING=false

# Model precision: "bfloat16" (recommended) or "float16"
WAN_TORCH_DTYPE=bfloat16

# ============================================================================
# Debugging Options
# ============================================================================

# Enable verbose generation logging
VERBOSE_GENERATION_LOGS=false

# ============================================================================
# Legacy Configuration (not used with WAN 2.2, kept for reference)
# ============================================================================
# OPENSORA_PATH=/home/ubuntu/Open-Sora
# MODEL_RESOLUTION=768px
# CHECKPOINT_PATH=hpcai-tech/OpenSora-STDiT-v3/model.safetensors
