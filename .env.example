# Environment Configuration for Open-Sora Service
# Copy this file to .env and fill in your values

# Lambda Labs API Key (for programmatic instance management)
LAMBDA_API_KEY=secret_sora2_YOUR_KEY_HERE

# GPU Service Configuration
GPU_SERVICE_URL=http://your-lambda-instance-ip:8001
GPU_API_KEY=your-secret-key-123

# Local Backend Configuration
USE_REMOTE_GPU=true
HOST=127.0.0.1
PORT=8000

# Open-Sora Configuration (for GPU service on Lambda)
OPENSORA_PATH=/home/ubuntu/Open-Sora
