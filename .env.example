# Environment Configuration for Open-Sora Service
# Copy this file to .env and fill in your values

# Lambda Labs API Key (for programmatic instance management)
LAMBDA_API_KEY=secret_sora2_YOUR_KEY_HERE

# GPU Service Configuration
GPU_SERVICE_URL=http://your-lambda-instance-ip:8001
GPU_API_KEY=your-secret-key-123

# Local Backend Configuration
USE_REMOTE_GPU=true
HOST=127.0.0.1
PORT=8000

# Open-Sora Configuration (for GPU service on Lambda)
OPENSORA_PATH=/home/ubuntu/Open-Sora

# Quality Settings (for GPU service)
# These control the default quality parameters used by the GPU service
# Run ./enable_max_quality.sh to automatically upgrade to maximum quality
DEFAULT_NUM_STEPS=120          # Diffusion steps (20-300, higher=better quality but slower)
DEFAULT_GUIDANCE=12.0          # Text prompt adherence (1.0-20.0, higher=stronger)
DEFAULT_GUIDANCE_IMG=3.5       # Image influence for I2V (0.5-10.0, higher=stronger face preservation)

# Optional: API Key for GPU service authentication
# Uncomment and set to enable authentication on GPU service
# GPU_SERVICE_API_KEY=your-gpu-secret-key-here

# Optional: Model checkpoint override
# Uncomment to use a specific model checkpoint
# CHECKPOINT_PATH=hpcai-tech/OpenSora-STDiT-v3/model.safetensors

# Debugging Options
# Enable verbose generation logging to see full stdout/stderr from inference
# Useful for diagnosing generation issues (static videos, errors, etc.)
VERBOSE_GENERATION_LOGS=false
